MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=livechat
MONGODB_THREAT_DATABASE=threat_gateway
MONGODB_COLLECTION=threat_events

EMAIL_ENABLED=true
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_gmail_app_password
EMAIL_RECEIVER=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

ALERT_RATE_LIMIT_THRESHOLD=1
ALERT_IDLE_THRESHOLD=3
ALERT_REJECTED_THRESHOLD=10
ALERT_COOLDOWN=30

MAX_CONNECTIONS=100
IDLE_TIMEOUT_SECONDS=120
RATE_LIMIT_WINDOW_SECONDS=5
MAX_MESSAGES_PER_WINDOW=10
RECONNECT_LIMIT=300
TEMP_BAN_SECONDS=120
ANOMALY_SCORE_THRESHOLD=0.95
THREAT_STRIKE_THRESHOLD=20
PROTECTION_ENABLED=true